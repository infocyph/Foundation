{
    "name": "infocyph/foundation",
    "description": "Performance-first application foundation for the Infocyph PHP ecosystem.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.0",
        "infocyph/arraykit": "^5.3.2",
        "infocyph/cachelayer": "^4.0.2",
        "infocyph/intermix": "^11.2.1",
        "infocyph/runwire": "^3.0.1",
        "infocyph/uid": "^6.0.1",
        "infocyph/webrick": "^6.0.4",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "ext-sodium": "*",
        "infocyph/dblayer": "^6.1.4",
        "infocyph/epicrypt": "^3.3",
        "infocyph/omnibus": "^3.0.3",
        "infocyph/otp": "^7.0.1",
        "infocyph/pathwise": "^4.2.1",
        "infocyph/phpforge": "dev-main@dev",
        "infocyph/reqshield": "^3.3.1",
        "infocyph/talkingbytes": "^2.3.1",
        "opis/closure": "^4.5",
        "web-auth/webauthn-lib": "^5.3.12"
    },
    "conflict": {
        "infocyph/dblayer": "<6.1.4",
        "infocyph/epicrypt": "<3.3",
        "infocyph/omnibus": "<3.0.3",
        "infocyph/otp": "<7.0.1",
        "infocyph/pathwise": "<4.2.1",
        "infocyph/reqshield": "<3.3.1",
        "infocyph/talkingbytes": "<2.3.1",
        "league/flysystem-local": "<3.25.1",
        "league/mime-type-detection": "<1.16",
        "psr/http-factory": "<1.1",
        "spomky-labs/pki-framework": "<1.6.2",
        "symfony/clock": "<6.4.3 || >=7.0 <7.0.3",
        "symfony/polyfill-php83": "<1.30",
        "symfony/property-access": "<6.4.3 || >=7.0 <7.0.3",
        "symfony/property-info": "<6.4.3 || >=7.0 <7.0.3",
        "symfony/serializer": "<6.4.3 || >=7.0 <7.0.3",
        "symfony/uid": "<6.4.3 || >=7.0 <7.0.3",
        "web-auth/webauthn-lib": "<5.3.12"
    },
    "suggest": {
        "ext-sodium": "Required when OTP AOTP/Ed25519 factors are enabled.",
        "infocyph/dblayer": "Adds database services, persistence, migrations, query caching, replicas, and MySQL/MariaDB/PostgreSQL/SQLite/SQL Server support.",
        "infocyph/epicrypt": "Adds cryptography, secrets, password, JOSE, OAuth 2.1/OIDC/PAT protocol services, and key security services.",
        "infocyph/omnibus": "Adds events, messages, durable queues, handler middleware, workers, optional process pools, retries, workflows, and scheduled-message dispatch.",
        "infocyph/otp": "Adds OTP-backed multi-factor authentication and Passkey/WebAuthn ceremony integration with CacheLayer-backed replay-safe state.",
        "infocyph/pathwise": "Adds filesystem, storage, upload, download, archive, sync, retention, and storage capability enforcement.",
        "infocyph/reqshield": "Adds request, command, configuration, schema, sanitization, typed input, and database validation services.",
        "infocyph/talkingbytes": "Adds HTTP, inbound/outbound email, webhook, and gRPC communication services.",
        "web-auth/webauthn-lib": "Required by OTP Passkey when the WebAuthn passkey driver is selected."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\Foundation\\": "src/"
        },
        "files": [
            "src/Config/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\Foundation\\Benchmarks\\": "benchmarks/",
            "Infocyph\\Foundation\\Tests\\Fixtures\\": "tests/Fixtures/"
        }
    },
    "bin": [
        "bin/infbyte"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "phpforge": {
            "skipper_policy": {
                "default": "deny",
                "rules": [
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "tests/Fixtures/ProbeInput.php"
                        ],
                        "reason": "Canonical local workspace paths and reconstructed loopback HTTP URLs reject remote wrappers, traversal, symlink escapes and file URI selection.",
                        "security": {
                            "sanitizer": "tests/Fixtures/ProbeInput.php",
                            "sha256": "4889f5cec4ffa08c01d13348c2c7c3029b8573af46b31a3dc218a601aac0c6f6",
                            "tests": [
                                "tests/Feature/ProbeInputTest.php"
                            ]
                        },
                        "taint": "file"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "tests/Fixtures/ProbeInput.php"
                        ],
                        "reason": "Local path authorities and fixed 127.0.0.1 HTTP endpoints reject remote hosts, credentials, queries and fragments.",
                        "security": {
                            "sanitizer": "tests/Fixtures/ProbeInput.php",
                            "sha256": "4889f5cec4ffa08c01d13348c2c7c3029b8573af46b31a3dc218a601aac0c6f6",
                            "tests": [
                                "tests/Feature/ProbeInputTest.php"
                            ]
                        },
                        "taint": "ssrf"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "tests/Fixtures/ProbeInput.php"
                        ],
                        "reason": "Canonical local paths and rebuilt loopback endpoints reject URL controls; ports are native validated integers and endpoint paths are a finite set.",
                        "security": {
                            "sanitizer": "tests/Fixtures/ProbeInput.php",
                            "sha256": "4889f5cec4ffa08c01d13348c2c7c3029b8573af46b31a3dc218a601aac0c6f6",
                            "tests": [
                                "tests/Feature/ProbeInputTest.php"
                            ]
                        },
                        "taint": "url_component"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "tests/Fixtures/ProbeInput.php"
                        ],
                        "reason": "Canonical local containment and finite rebuilt loopback endpoint paths reject traversal, wrappers, query and fragment injection.",
                        "security": {
                            "sanitizer": "tests/Fixtures/ProbeInput.php",
                            "sha256": "4889f5cec4ffa08c01d13348c2c7c3029b8573af46b31a3dc218a601aac0c6f6",
                            "tests": [
                                "tests/Feature/ProbeInputTest.php"
                            ]
                        },
                        "taint": "url_path"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "tests/Fixtures/ProbeInput.php"
                        ],
                        "reason": "Only project() authorizes operator-selected source directories after canonical containment and non-world-writable permission checks; data-file paths retain include taint.",
                        "security": {
                            "sanitizer": "tests/Fixtures/ProbeInput.php",
                            "sha256": "4889f5cec4ffa08c01d13348c2c7c3029b8573af46b31a3dc218a601aac0c6f6",
                            "tests": [
                                "tests/Feature/ProbeInputTest.php"
                            ]
                        },
                        "taint": "include"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "tests/Fixtures/ProbeInput.php"
                        ],
                        "reason": "Only project() clears shell taint after canonical containment and an explicit shell-inert character allowlist; data-file paths retain shell taint.",
                        "security": {
                            "sanitizer": "tests/Fixtures/ProbeInput.php",
                            "sha256": "4889f5cec4ffa08c01d13348c2c7c3029b8573af46b31a3dc218a601aac0c6f6",
                            "tests": [
                                "tests/Feature/ProbeInputTest.php"
                            ]
                        },
                        "taint": "shell"
                    }
                ]
            }
        }
    },
    "scripts": {
        "benchmark:arraykit": "@php benchmarks/arraykit-config-utilization.php",
        "benchmark:cachelayer": "@php benchmarks/cachelayer-utilization.php",
        "benchmark:dblayer": "@php benchmarks/dblayer-utilization.php",
        "benchmark:epicrypt": "@php benchmarks/epicrypt-utilization.php",
        "benchmark:maintenance": "@php benchmarks/maintenance-overhead.php",
        "benchmark:omnibus": "@php benchmarks/omnibus-utilization.php",
        "benchmark:otp": "@php benchmarks/otp-utilization.php",
        "benchmark:pathwise": "@php benchmarks/pathwise-utilization.php",
        "benchmark:phase9:di": "@php benchmarks/phase9-di-attribution.php",
        "benchmark:phase9:http": "@php benchmarks/phase9-http-attribution.php",
        "benchmark:release": [
            "@benchmark:uid",
            "@benchmark:cachelayer",
            "@benchmark:dblayer",
            "@benchmark:epicrypt",
            "@benchmark:omnibus",
            "@benchmark:otp",
            "@benchmark:pathwise",
            "@benchmark:reqshield",
            "@benchmark:talkingbytes"
        ],
        "benchmark:representative": "@php benchmarks/run-representative.php",
        "benchmark:reqshield": "@php benchmarks/reqshield-utilization.php",
        "benchmark:talkingbytes": "@php benchmarks/talkingbytes-utilization.php",
        "benchmark:uid": "@php benchmarks/uid-runtime-utilization.php"
    }
}
